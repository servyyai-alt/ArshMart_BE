# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/sandhaikart

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Shiprocket
SHIPROCKET_EMAIL=your_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Primary

# Return policy
RETURN_WINDOW_DAYS=7

# Return warehouse (required for reverse pickup/returns)
RETURN_WAREHOUSE_NAME=Sandhaikart Warehouse
RETURN_WAREHOUSE_PHONE=9999999999
RETURN_WAREHOUSE_ADDRESS1=Your warehouse address line 1
RETURN_WAREHOUSE_ADDRESS2=
RETURN_WAREHOUSE_CITY=Chennai
RETURN_WAREHOUSE_STATE=Tamil Nadu
RETURN_WAREHOUSE_PINCODE=600001
RETURN_WAREHOUSE_COUNTRY=India

# Frontend URL (for CORS and WhatsApp order links)
FRONTEND_URL=http://localhost:5173

# Admin Default
ADMIN_EMAIL=admin@sandhaikart.com
ADMIN_PASSWORD=Admin@123

# Email (SMTP) - used for order confirmation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Sandhaikart <no-reply@sandhaikart.com>"

# Optional
APP_NAME=Sandhaikart

# WhatsApp notification service and secured queue worker
# Set WHATSAPP_SERVICE_BASE_URL to the deployed WhatsApp service URL.
# WHATSAPP_INTERNAL_API_KEY must match DASHBOARD_INTERNAL_API_KEY in the WhatsApp service.
WHATSAPP_SERVICE_BASE_URL=https://your-whatsapp-service.vercel.app
WHATSAPP_INTERNAL_API_KEY=use_the_same_value_as_dashboard_internal_api_key

# Vercel cron / external scheduler (minute-based queue processing)
# Use the same secret value for both variables.
CRON_SECRET=generate_a_random_secret_with_at_least_32_characters
WHATSAPP_QUEUE_CRON_SECRET=use_the_same_value_as_cron_secret
